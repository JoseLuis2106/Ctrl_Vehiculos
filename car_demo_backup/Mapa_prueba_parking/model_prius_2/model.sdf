      <!-- ═══ Coche Derecha ════════════════════════════════════════════════
           Desplazado −0.1 m en X respecto a la versión anterior para que
           el hueco entre Wall_25 (Coche Centro) y Wall_32 sea exactamente
           6.0 m de luz interior.
           Verificación:
             cara derecha Wall_25  = (−0.23593 − 0.78945) + 0.075 = −0.95038 m
             cara izquierda Wall_32 = (−0.23593 + 5.36055) − 0.075 =  5.04962 m
             hueco = 5.04962 − (−0.95038) = 6.000 m  ✓             -->
      <link name='Wall_32'>
        <pose>5.36055 0.12388 0 0 -0 1.5708</pose>
        <collision name='collision'>
          <pose>0 0 1.25 0 -0 0</pose>
